
# Application
APP_PORT=3000
APP_ENV=development
APP_ROLE=all

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=bakeorder
DB_SSLMODE=disable
DB_MAX_CONNS=10

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=bakeorder

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=bakeorder_local_secret_2026_change_before_deployment
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
